SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
TINYDB_PATH=data/auth
# For local dev: sqlite:///data/inventory.db
# For Supabase: postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=sqlite:///data/inventory.db# In-process response cache for heavy inventory reads (see CACHING_REPORT.md).
# Set to false to measure without cache or as a kill switch.
CACHE_ENABLED=true
# Telemetry (docs/telemetry/telemetry-plan.md §4.5): secret pepper for the
# HMAC of emails in login_failed. Long random value, keep it out of git.
TELEMETRY_HASH_PEPPER=replace-with-a-long-random-secret
# Git short SHA of the deployed build, reported as context.appVersion.
APP_VERSION=0000000
