# Copia este archivo como .env.local (no se sube a git).

# Endpoint de ingesta de telemetría (POST, lotes { "events": [...] }).
# Hoy y mañana es la misma URL: el frontend no cambia cuando cambia el backend.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Opcionales: entorno y versión que viajan en context.environment / context.appVersion.
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_APP_VERSION=0000000
